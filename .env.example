# ==========================================
# HOSPITAL NEXT.JS PLATFORM ENVIRONMENT CONFIG
# ==========================================

# Database: Raw MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/al_insaf_hospital
MONGODB_DB=al_insaf_hospital

# Cloudinary Image Storage & Upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=hospital_uploads

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
ADMIN_DEFAULT_EMAIL=admin@hospital.com
ADMIN_DEFAULT_PASSWORD=AdminHospital@2026#Secure

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# SMTP Email Configuration for Password Recovery & Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Al Insaf General Hospital" <noreply@alinsafhospital.com>

# Hospital Public Metadata
NEXT_PUBLIC_HOSPITAL_NAME=Al Insaf General Hospital
NEXT_PUBLIC_HOSPITAL_PHONE=01303-359905
NEXT_PUBLIC_HOSPITAL_PHONE_ALT=01913-129020
NEXT_PUBLIC_EMERGENCY_PHONE=01303-359905
NEXT_PUBLIC_HOSPITAL_EMAIL=alinsafhospital2025@gmail.com
NEXT_PUBLIC_HOSPITAL_ADDRESS=Govt. High School Gate, Dewanganj Bazar, Dewanganj, Jamalpur, Bangladesh
NEXT_PUBLIC_HOSPITAL_MAPS_URL=https://www.google.com/maps/search/Dewanganj+Government+High+School+Jamalpur
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMS Gateway Configuration
SMS_GATEWAY_PROVIDER=greenweb
SMS_API_KEY=your_sms_api_key_or_token
# Optional Gateway Keys
BULKSMSBD_API_KEY=your_bulksmsbd_key
BULKSMSBD_SENDER_ID=your_sender_id
ALPHASMS_API_KEY=your_alphasms_key
ALPHASMS_SENDER_ID=your_sender_id
SSLWIRELESS_API_TOKEN=your_ssl_token
SSLWIRELESS_SID=your_sid
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone
