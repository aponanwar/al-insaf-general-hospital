# ==========================================
# HOSPITAL NEXT.JS PLATFORM ENVIRONMENT CONFIG
# ==========================================

# Database: Raw MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/al_insaf_hospital
MONGODB_DB=al_insaf_hospital

# Cloudinary Image Storage & Upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=hospital_uploads

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
ADMIN_DEFAULT_EMAIL=admin@hospital.com
ADMIN_DEFAULT_PASSWORD=AdminHospital@2026#Secure

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# SMTP Email Configuration for Password Recovery & Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Al Insaf General Hospital" <noreply@alinsafhospital.com>

# Hospital Public Metadata
NEXT_PUBLIC_HOSPITAL_NAME=Al Insaf General Hospital
NEXT_PUBLIC_HOSPITAL_PHONE=09666 787800
NEXT_PUBLIC_EMERGENCY_PHONE=01711-000000
NEXT_PUBLIC_HOSPITAL_EMAIL=info@alinsafhospital.com
NEXT_PUBLIC_HOSPITAL_ADDRESS=House 08, Road 02, Dhanmondi, Dhaka-1205, Bangladesh
NEXT_PUBLIC_APP_URL=http://localhost:3000
